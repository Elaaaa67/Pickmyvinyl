<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Pick My Vinyl{% endblock %}</title>
    <style>
        body {
            font-family: 'Merriweather', serif;
            color: #333;
            background-color: #F2EFE9;
            margin: 0;
            padding: 0;
        }
        .container {
            max-width: 600px;
            margin: 20px auto;
            background-color: white;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            overflow: hidden;
        }
        .header {
            background-color: #3D0D0D;
            color: white;
            padding: 20px;
            text-align: center;
        }
        .header h1 {
            margin: 0;
            font-size: 1.5rem;
        }
        .content {
            padding: 30px;
            line-height: 1.6;
        }
        .content h1 {
            color: #3D0D0D;
            font-size: 1.3rem;
            margin-top: 0;
        }
        .footer {
            background-color: #f5f5f5;
            padding: 20px;
            text-align: center;
            font-size: 0.85rem;
            color: #666;
            border-top: 1px solid #eee;
        }
        .footer a {
            color: #3D0D0D;
            text-decoration: none;
        }
        a {
            color: #3D0D0D;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>🎵 Pick My Vinyl</h1>
        </div>
        <div class="content">
            {% block content %}{% endblock %}
        </div>
        <div class="footer">
            <p>
                © 2026 Pick My Vinyl. Tous droits réservés.<br>
                <a href="http://localhost:8000">www.pickmyvinyl.com</a>
            </p>
        </div>
    </div>
</body>
</html>

