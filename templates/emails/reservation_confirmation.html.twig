{% extends 'emails/base_email.html.twig' %}

{% block title %}Confirmation de votre réservation - Pick My Vinyl{% endblock %}

{% block content %}
    <h1>Votre réservation est confirmée!</h1>

    <p>Merci {{ user.fullName }}, votre réservation a été créée avec succès.</p>

    <div style="background: #f9f9f9; padding: 20px; border-radius: 8px; margin: 20px 0;">
        <h3 style="margin-top: 0; color: #3D0D0D;">Détails de votre réservation</h3>

        <p>
            <strong>Numéro de réservation:</strong> #{{ reservation.id }}<br>
            <strong>Date:</strong> {{ reservation.createdAt|date('d/m/Y H:i') }}<br>
            <strong>Statut:</strong> <span style="color: #ffc107; font-weight: bold;">En attente de validation</span>
        </p>

        <hr style="border: none; border-top: 1px solid #eee;">

        <h4 style="color: #3D0D0D;">Vinyle réservé</h4>
        <p>
            <strong>{{ vinyl.title }}</strong><br>
            Artiste: {{ vinyl.artist }}<br>
            Quantité: {{ reservation.quantity }}
        </p>

        <h4 style="color: #3D0D0D;">Lieu de retrait</h4>
        <p>
            <strong>{{ store.name }}</strong><br>
            Adresse: {{ store.address }}<br>
            {% if store.phone %}
                Téléphone: {{ store.phone }}<br>
            {% endif %}
        </p>
    </div>

    <div style="background: #fff3cd; border-left: 4px solid #ffc107; padding: 15px; margin: 20px 0; border-radius: 4px;">
        <strong>⏱️ Important:</strong> Vous avez <strong>7 jours</strong> pour venir récupérer votre réservation en magasin après validation par le gérant.
    </div>

    <p style="color: #666; font-size: 0.9rem;">
        Consultez votre réservation en vous connectant à votre compte:
        <a href="http://localhost:8000/reservation/{{ reservation.id }}" style="color: #3D0D0D; text-decoration: none; font-weight: bold;">
            Voir ma réservation
        </a>
    </p>

    <hr style="border: none; border-top: 1px solid #eee; margin: 30px 0;">

    <p style="color: #999; font-size: 0.85rem;">
        Merci de votre confiance chez Pick My Vinyl!<br>
        Si vous avez des questions, contactez directement le magasin.
    </p>
{% endblock %}

