{# templates/vinyl/panier.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Vinyles du Panier - Pick My Vinyl{% endblock %}

{% block body %}
<div class="container py-5">
    <h1 class="mb-4">
        <i class="fas fa-shopping-cart"></i> Vinyles dans votre panier
    </h1>

    {% if cartItems|length > 0 %}
        <div class="row">
            <div class="col-md-12">
                <div class="vinyl-grid">
                    {% for item in cartItems %}
                        <div class="vinyl-card">
                            <div class="card h-100">
                                {% if item.coverImage %}
                                    <img src="{{ item.coverImage }}" alt="{{ item.title }}" class="card-img-top">
                                {% else %}
                                    <img src="{{ asset('images/placeholder.png') }}" alt="Image manquante" class="card-img-top">
                                {% endif %}
                                <div class="card-body">
                                    <h5 class="card-title">{{ item.title }}</h5>
                                    <p class="card-text text-muted">{{ item.artist ?? 'Artiste inconnu' }}</p>

                                    <div class="mt-3">
                                        <span class="badge bg-primary">Quantité : {{ item.quantity }}</span>
                                    </div>

                                    <div class="mt-3">
                                        <a href="{{ path('app_catalog') }}" class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-eye"></i> Catalogue
                                        </a>
                                        <form method="POST" action="{{ path('app_cart_remove', {'id': item.vinylId}) }}" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="fas fa-trash"></i> Supprimer
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-md-12">
                <div class="alert alert-info">
                    <strong>Total :</strong> {{ cartTotal }} vinyle(s) dans votre panier
                </div>
                <a href="{{ path('app_cart_show') }}" class="btn btn-primary btn-lg">
                    <i class="fas fa-shopping-cart"></i> Voir le panier complet
                </a>
                <a href="{{ path('app_catalog') }}" class="btn btn-outline-secondary btn-lg">
                    <i class="fas fa-compact-disc"></i> Continuer vos achats
                </a>
            </div>
        </div>
    {% else %}
        <div class="alert alert-warning" role="alert">
            <h4 class="alert-heading">Panier vide</h4>
            <p>Vous n'avez aucun vinyle dans votre panier pour le moment.</p>
            <hr>
            <a href="{{ path('app_catalog') }}" class="btn btn-primary">
                <i class="fas fa-compact-disc"></i> Parcourir le catalogue
            </a>
        </div>
    {% endif %}
</div>

<style>
    .vinyl-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .vinyl-card {
        transition: transform 0.3s ease;
    }

    .vinyl-card:hover {
        transform: translateY(-5px);
    }

    .card-img-top {
        height: 250px;
        object-fit: cover;
    }

    .card {
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .card:hover {
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
    }
</style>
{% endblock %}

