{# templates/reservation/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Mes réservations - Pick My Vinyl{% endblock %}

{% block body %}
<div class="container py-5">
    <h1 class="mb-4">
        <i class="fas fa-list"></i> Mes réservations
    </h1>

    {% if reservations|length > 0 %}
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Vinyle</th>
                        <th>Enseigne</th>
                        <th>Quantité</th>
                        <th>Statut</th>
                        <th>Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for reservation in reservations %}
                        <tr>
                            <td>
                                <strong>{{ reservation.vinyl.title ?? 'N/A' }}</strong>
                                <br>
                                <small class="text-muted">{{ reservation.vinyl.artist ?? '' }}</small>
                            </td>
                            <td>{{ reservation.store.name ?? 'N/A' }}</td>
                            <td>{{ reservation.quantity ?? 1 }}</td>
                            <td class="text-center">
                                {% set status_class = 'status-' ~ (reservation.status|default('pending')) %}
                                <span class="badge-status {{ status_class }}">
        {% if reservation.status == 'pending' %}
            <i class="fas fa-clock"></i> EN ATTENTE
        {% elseif reservation.status == 'confirmed' %}
            <i class="fas fa-check"></i> CONFIRMÉE
        {% elseif reservation.status == 'collected' %}
            <i class="fas fa-box"></i> RÉCUPÉRÉE
        {% elseif reservation.status == 'cancelled' %}
            <i class="fas fa-times"></i> ANNULÉE
        {% else %}
            {{ reservation.status|upper }}
        {% endif %}
    </span>
                            </td>
                            <td>
                                {% if reservation.createdAt %}
                                    {{ reservation.createdAt|date('d/m/Y H:i') }}
                                {% else %}
                                    N/A
                                {% endif %}
                            </td>
                            <td>
                                <a href="{{ path('app_reservation_show', {id: reservation.id}) }}" class="btn btn-sm btn-info">
                                    <i class="fas fa-eye"></i> Détail
                                </a>
                                {% if reservation.status != 'cancelled' and reservation.status != 'picked_up' %}
                                    <form method="POST" action="{{ path('app_reservation_cancel', {id: reservation.id}) }}" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Annuler cette réservation ?')">
                                            <i class="fas fa-times"></i> Annuler
                                        </button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="alert alert-info" role="alert">
            <h4 class="alert-heading">Aucune réservation</h4>
            <p>Vous n'avez aucune réservation pour le moment.</p>
            <hr>
            <p class="mb-0">
                <a href="{{ path('app_catalog') }}" class="btn btn-primary btn-sm">
                    <i class="fas fa-compact-disc"></i> Parcourir le catalogue
                </a>
            </p>
        </div>
    {% endif %}
</div>

    <style>

        /* Titre stylisé */
        h1 {
            font-family: 'Playfair Display', serif;
            color: #3D0D0D;
            font-weight: 700;
            font-style: italic;
            padding: 20px 0;
            border-bottom: 2px solid #3D0D0D;
            margin-bottom: 40px;
        }

        /* Table Card */
        .table-responsive {
            background: white;
            border-radius: 4px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            border: 1px solid #e0dcd5;
        }

        .table thead th {
            background-color: #3D0D0D; /* Bordeaux profond */
            color: #F2EFE9;
            font-family: 'Playfair Display', serif;
            text-transform: capitalize;
            letter-spacing: 1px;
            border: none;
            padding: 18px;
        }

        .table tbody td {
            padding: 20px;
            vertical-align: middle;
            border-color: #f0ede7;
            font-family: 'Merriweather', serif;
            color: #333;
        }

        /* Badges de Statut (Comme sur ton image) */
        .badge-status {
            display: inline-block;
            padding: 6px 14px;
            border-radius: 50px; /* Forme pilule */
            font-size: 0.7rem;
            font-weight: 800;
            letter-spacing: 0.8px;
            color: white;
            text-align: center;
            min-width: 110px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

        /* Couleurs spécifiques par statut */
        .status-pending {
            background-color: #D4AF37; /* Or / Moutarde */
        }

        .status-confirmed {
            background-color: #2D5A27; /* Vert Forêt */
        }

        .status-collected {
            background-color: #6c757d; /* Gris pro */
        }

        .status-cancelled {
            background-color: #3D0D0D; /* Bordeaux (rappel du thème) */
        }

        /* On centre bien le texte dans la cellule */
        .table td {
            text-align: center;
        }

        /* On garde l'alignement à gauche pour le titre du vinyle uniquement */
        .table td:first-child {
            text-align: left;
        }

        /* Boutons d'Action */
        .btn-group-actions {
            display: flex;
            flex-direction: column;
            gap: 5px;
            align-items: center;
        }

        .btn-detail {
            background-color: #3D0D0D;
            color: white;
            border: none;
            padding: 5px 20px;
            border-radius: 4px;
            font-size: 0.85rem;
            transition: 0.3s;
        }

        .btn-detail:hover {
            background-color: #631D22;
            transform: translateY(-1px);
        }

        .btn-cancel {
            background: transparent;
            color: #3D0D0D;
            border: 1px solid #3D0D0D;
            font-size: 0.75rem;
            padding: 2px 10px;
            border-radius: 4px;
        }
    </style>
{% endblock %}

