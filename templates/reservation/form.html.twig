{% extends 'base.html.twig' %}

{% block title %}Formulaire réservation{% endblock %}

{% block body %}
<h1>{% if reservation is defined %}Éditer{% else %}Créer{% endif %} une réservation</h1>
{{ form_start(form) }}
    {{ form_widget(form) }}
    <button>{{ reservation is defined ? 'Enregistrer' : 'Créer' }}</button>
{{ form_end(form) }}
{% endblock %}

